# Development-only example. Copy to .env only if your process manager loads it;
# Django itself reads exported environment variables and does not load this file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=csl_system_dev
POSTGRES_USER=csl_system_dev
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
